generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SELLER
  CUSTOMER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  role            Role      @default(CUSTOMER)
  sessionVersion  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Set when the owner enters the code we email at sign-up. Accounts without it cannot log in.
  emailVerifiedAt DateTime?
  // Set by an administrator to deactivate an account while retaining its history.
  removedAt       DateTime?

  sellerProfile        SellerProfile?
  customerProfile      CustomerProfile?
  adminProfile         AdminProfile?
  profilePhoto         ProfilePhoto?
  learningProgress     LearningProgress?
  learningCertificates LearningCertificate[]
}

model LearningCourse {
  id        String                @id @default(uuid())
  courseId  String                @unique
  content   Json                  @db.JsonB
  published Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  media     LearningCourseMedia[]
}

model LearningCourseMedia {
  id          String         @id @default(uuid())
  courseId    String
  course      LearningCourse @relation(fields: [courseId], references: [courseId], onDelete: Cascade)
  slot        String
  contentType String
  data        Bytes          @db.ByteA
  updatedAt   DateTime       @updatedAt

  @@unique([courseId, slot])
}

model LearningProgress {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress  Json     @default("{}") @db.JsonB
  updatedAt DateTime @updatedAt
}

model LearningCertificate {
  id                String   @id @default(uuid())
  certificateCode   String   @unique @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  courseTitle       String
  learnerName       String
  lessonCount       Int
  quizScore         Int
  quizQuestionCount Int
  issuedAt          DateTime @default(now())

  @@unique([userId, courseId])
}

// A customer's profile photo (a small square picture stored as a data URL)
model ProfilePhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String   @db.Text
  updatedAt DateTime @updatedAt
}

// Ministry staff who use the admin dashboard (they log in with email + NIC + emailed code)
model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  nicNumber String   @unique
  // The primary admin (the first one) is the only admin who can remove other admins
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SellerProfile {
  id           String            @id @default(uuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  description  String?
  district     String
  firstName    String?
  dateOfBirth  DateTime?         @db.Date // worked out from the NIC number at sign-up
  lastName     String?
  // Old plain-text column: now only holds a placeholder. The real NIC is kept encrypted (see utils/nicVault.js).
  nicNumber    String            @unique
  nicHash      String?           @unique // lets the site spot a NIC that is already registered without storing it
  nicEncrypted String?
  nicLast5     String? // the only part an admin can see
  status       ApplicationStatus @default(PENDING)

  // NIC photos for identity verification (front and back sides)
  nicFront     String?           @db.Text
  nicBack      String?           @db.Text

  // Direct Social Media Redirection Links
  whatsappNo   String?
  facebookUrl  String?
  messengerUrl String?

  // Set when an admin removes the seller. The account is closed but its orders and complaints are kept.
  removedAt   DateTime?
  removalNote String?

  products   Product[]
  analytics  ClickAnalytics[]
  orders     Order[]
  complaints Complaint[]
  reviews    SellerReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerProfile {
  id                    String          @id @default(uuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  // Customers log in with email + NIC + emailed code. Empty only for accounts made before that.
  nicNumber             String?         @unique
  orders                Order[]
  complaints            Complaint[]
  reviews               ProductReview[]
  sellerReviews         SellerReview[]
  wishlistItems         WishlistItem[]
  savedDeliveryName     String?
  savedDeliveryPhone    String?
  savedDeliveryAddress  String?         @db.Text
  savedDeliveryDistrict String?
  cart                  Json            @default("[]") @db.JsonB
}

// A photo a seller uploaded for a product (kept in the database; the product's images list holds its address)
model ProductImage {
  id        String   @id
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      String   @db.Text
  createdAt DateTime @default(now())

  @@index([productId])
}

model Product {
  id              String         @id @default(uuid())
  sellerId        String
  seller          SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  description     String
  category        String
  images          String[]
  // Null means the seller has not enabled inventory tracking for this product.
  stock           Int?
  productImages   ProductImage[]
  price           Decimal?
  // A seller's discount: percent off the price, optionally until the end of a day
  discountPercent Int?
  discountEndsAt  DateTime?
  // Facebook Messenger chat link for this product (m.me/... or a Facebook page link)
  messengerUrl    String?
  isPublished     Boolean        @default(true)

  analytics     ClickAnalytics[]
  orderItems    OrderItem[]
  reviews       ProductReview[]
  wishlistItems WishlistItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model WishlistItem {
  id         String          @id @default(uuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

model ProductReview {
  id         String          @id @default(uuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String          @db.VarChar(1000)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([productId, customerId])
  @@index([productId, createdAt])
}

model SellerReview {
  id         String          @id @default(uuid())
  sellerId   String
  seller     SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String          @db.VarChar(1000)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([sellerId, customerId])
  @@index([sellerId, createdAt])
}

model ClickAnalytics {
  id        String         @id @default(uuid())
  productId String?
  product   Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String?
  seller    SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  channel   String
  createdAt DateTime       @default(now())
}

enum OrderStatus {
  PENDING
  ACCEPTED
  CANCELLED
  DELIVERED
}

model Order {
  id              String          @id @default(uuid())
  orderNumber     String          @unique
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String
  customerAddress String
  district        String
  totalAmount     Decimal
  status          OrderStatus     @default(PENDING)
  notes           String?
  items           OrderItem[]
  complaints      Complaint[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([sellerId])
  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  price       Decimal
  productName String
  createdAt   DateTime @default(now())

  @@index([orderId])
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Complaint {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    String
  description String
  status      ComplaintStatus @default(OPEN)
  adminNotes  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sellerId])
  @@index([customerId])
  @@index([orderId])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
