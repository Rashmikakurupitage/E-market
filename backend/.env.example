# Lanka Women E-Market - Environment variables

PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/emarketnew?schema=public"
# Generate a random secret (for example, `openssl rand -base64 48`) before starting the backend.
JWT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NIC_ENCRYPTION_KEY=

# Comma-separated exact frontend origins, e.g. https://shop.example.com
# Local development also allows localhost:3000 and localhost:3001.
CORS_ALLOWED_ORIGINS=
# Only set when the backend is behind a trusted reverse proxy; value is proxy hop count.
# TRUST_PROXY_HOPS=1
# Defaults to lax. Prefer hosting frontend and API on the same site. Use none only with HTTPS if cross-site cookies are unavoidable.
# AUTH_COOKIE_SAME_SITE=lax

# Google Cloud Translation API key for automatic e-learning course translations.
# Leave unset until the Cloud Translation API is enabled for your Google Cloud project.
GOOGLE_TRANSLATE_API_KEY=

# --- Email for login and verification codes ---
# Select "smtp" or "resend". If omitted, "smtp" is used.
EMAIL_PROVIDER=smtp

# Option A: standard SMTP (e.g. Gmail with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Lanka Women E-Market <you@gmail.com>"

# Option B: Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Lanka Women E-Market <onboarding@resend.dev>"

# Print one-time login codes to the console so development works without a mailer
EMAIL_DEV_LOG_CODES=true
