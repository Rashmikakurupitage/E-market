# Copy the lines you need into backend/.env and fill in your own values.

PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/emarketnew?schema=public"
# Generate a random secret (for example, `openssl rand -base64 48`) before starting the backend.
JWT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NIC_ENCRYPTION_KEY=

# Comma-separated exact frontend origins, e.g. https://shop.example.com
# Local development also allows localhost:3000 and localhost:3001.
CORS_ALLOWED_ORIGINS=
# Only set when the backend is behind a trusted reverse proxy; value is proxy hop count.
# TRUST_PROXY_HOPS=1
# Defaults to lax. Prefer hosting frontend and API on the same site. Use none only with HTTPS if cross-site cookies are unavoidable.
# AUTH_COOKIE_SAME_SITE=lax

# Google Cloud Translation API key for automatic e-learning course translations.
# Leave unset until the Cloud Translation API is enabled for your Google Cloud project.
GOOGLE_TRANSLATE_API_KEY=

# --- Email for login and verification codes ---
# Select "smtp" or "resend". If omitted, "smtp" is used.
EMAIL_PROVIDER=smtp
#
# Gmail SMTP example: use a Gmail App Password, not your normal password.
# To use implicit SSL, set port 465; port 587 uses STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="Lanka Women E-Market <your.address@gmail.com>"

# Resend API alternative (requires an active API key and a verified sender domain).
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key
# MAIL_FROM="Lanka Women E-Market <login@your-verified-domain.example>"

# Optional local-only fallback: if email delivery fails, print the code in the backend terminal.
# It is ignored whenever NODE_ENV=production. Never enable this on a public/shared server.
# EMAIL_DEV_LOG_CODES=true
