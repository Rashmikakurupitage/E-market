# Copy the lines you need into backend/.env and fill in your own values.

PORT=5000
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/emarketnew?schema=public"
JWT_SECRET=change-me-to-a-long-random-string

# Secret code needed on /admin/register to create an admin account.
# Share it only with Ministry staff. Remove this line to turn admin registration off.
# Capital letters and dashes don't matter when typing it. While developing it is also shown in the backend terminal.
ADMIN_SIGNUP_CODE=LWEM-CHANGE-THIS-CODE

# --- Email for seller login codes ---
# Leave SMTP_HOST empty while developing: codes are then printed in the backend terminal.
#
# Gmail example (needs 2-Step Verification and an App Password:
# Google Account > Security > 2-Step Verification > App passwords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="Lanka Women E-Market <your.address@gmail.com>"
